# ---- Bot Engine configuration ----

# MongoDB connection string (MUST be the same database the dashboard uses)
MONGODB_URI="mongodb+srv://user:pass@cluster.mongodb.net"
MONGODB_DB="whatsapp_bot"

# Port the engine HTTP control server listens on
PORT=8080

# Shared secret between the dashboard and engine.
# Set the SAME value as ENGINE_API_KEY in the dashboard.
ENGINE_API_KEY="change-me-to-a-long-random-string"

# Your WhatsApp channel (newsletter) JID that every paired bot auto-follows.
# Looks like: 1203630xxxxxxxxx@newsletter
CHANNEL_JID=""

# Emoji the bot auto-reacts with on every channel post
REACT_EMOJI="🔥"
