{
  "buildCommand": "npm run build",
  "devCommand": "next dev",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "nodeVersion": "20.x",
  "env": {
    "NODE_OPTIONS": "--max-old-space-size=2048 --expose-gc"
  },
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60,
      "memory": 3008
    }
  },
  "redirects": [],
  "rewrites": [],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
